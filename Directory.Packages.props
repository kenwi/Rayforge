<Project>

  <ItemGroup>
    <!-- Raylib-cs 8.1.0 is the single raylib pin: managed bindings, the browser-wasm native
         archive and the desktop RID natives all come from it. See docs/UPGRADING-RAYLIB.md. -->
    <PackageVersion Include="Raylib-cs" Version="8.1.0" />

    <!-- Blazor WebAssembly -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
