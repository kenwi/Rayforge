<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Rayforge.Web</RootNamespace>
    <PackageId>Rayforge.Web</PackageId>
    <IsPackable>true</IsPackable>
    <!-- Required by [JSImport] (SYSLIB1074). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Blazor WebAssembly host for Rayforge games.</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Raylib-cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rayforge.Core\Rayforge.Core.csproj" />
  </ItemGroup>

  <!-- Shipped to consumers as buildTransitive (M4). In this repo Directory.Build.targets imports the
       same file for any project built with RuntimeIdentifier=browser-wasm. It is a .targets (not
       .props) because the Razor SDK already generates buildTransitive/Rayforge.Web.props for static
       web assets; NuGet imports both conventions, so the wasm flags need a different file name. -->
  <ItemGroup>
    <None Include="buildTransitive\**\*" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
