<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Filled by the RayforgeFeed template option. Point this at the folder produced by
         scripts/pack.sh, or at a published feed once the Rayforge packages are on a NuGet server. -->
    <add key="rayforge-local" value="__RAYFORGE_FEED__" />
  </packageSources>
</configuration>
