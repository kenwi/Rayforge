<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>RayforgeGame.Web</RootNamespace>
    <AssemblyName>RayforgeGame.Web</AssemblyName>
    <RayforgeHost>Web</RayforgeHost>

    <!-- The Rayforge.Web package supplies the wasm/native flags through buildTransitive. -->
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WasmGenerateAppBundle>true</WasmGenerateAppBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Rayforge.Web" />
    <ProjectReference Include="..\RayforgeGame.Game\RayforgeGame.Game.csproj" />
  </ItemGroup>

  <Import Project="..\Assets.props" />

</Project>
