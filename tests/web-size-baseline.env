# Limits for the published Hello World host (M5).
#
# Measured 2026-10-22 from a clean publish with the official -O0 link workaround: 6,633,481 raw bytes /
# 2,032,185 brotli bytes / 55 files / 2,491,188 dotnet.native bytes. Limits leave ~10% headroom (20% for
# file count), enough for an asset or a small framework change without hiding a real regression.
#
# When a deliberate change grows the payload, record the new measurement and why here.
MAX_RAW_BYTES=7400000
MAX_BROTLI_BYTES=2280000
MAX_FILES=72
MAX_NATIVE_WASM_BYTES=2750000
