# Build output
bin/
obj/
artifacts/
publish/
*.user
*.suo
.vs/
.idea/

# Local NuGet feed (scripts/pack.sh): keep the folder, not the packages.
nuget-local/*.nupkg
nuget-local/*.snupkg

# Test / tool output
TestResults/
playwright-report/
test-results/
node_modules/

# OS
.DS_Store
Thumbs.db

# Local configuration
*.local.json
.env
.env.*
!.env.example

# Spike: assets synced into the host's wwwroot by the build (see the M0 spike).
spike/**/wwwroot/assets/

# Game hosts: assets are copied here by games/<Game>/Assets.props at build time.
games/**/wwwroot/assets/

