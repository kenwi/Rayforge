<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Local packages produced by scripts/pack.sh. Relative paths are resolved from this file. -->
    <add key="rayforge-local" value="nuget-local" />
  </packageSources>
</configuration>
